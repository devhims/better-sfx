{
  "name": "better-sfx",
  "version": "1.0.0",
  "description": "Free, royalty-free sound effects for apps, videos and AI agents, with an agent skill. By video2ctx.",
  "homepage": "https://sfx.video2ctx.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devhims/better-sfx.git"
  },
  "bugs": "https://github.com/devhims/better-sfx/issues",
  "author": "video2ctx",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "keywords": ["sound effects", "sfx", "ui sounds", "web audio", "agent skill", "royalty-free"],
  "scripts": {
    "build": "node src/build.mjs && npm run skill:catalog",
    "skill:catalog": "node src/skill-categories.mjs",
    "site": "node src/site.mjs",
    "dev": "node src/site.mjs && node src/serve.mjs",
    "check": "tsc -p .",
    "test": "node --test tests/*.test.mjs",
    "audit": "node src/audit-gaps.mjs",
    "generate": "node src/generate-seed.mjs",
    "icons": "bash scripts/rasterize-icons.sh"
  },
  "dependencies": {
    "node-web-audio-api": "^2.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
